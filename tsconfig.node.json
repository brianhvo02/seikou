{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "encoder/web/vite.config.ts", "vite", "playwright.config.ts", "playwright.ass.config.ts", "playwright.encoder.config.ts", "scripts", "tests/e2e", "tests/doc-check.test.ts", "tests/public-api.test.ts", "tests/documentation.test.ts", "tests/devsite-model.test.ts", "tests/local", "tests/vm-trace", "tests/ass-trace", "tools/disc-server", "tools/devices", "tools/bdj-library"],
  "exclude": ["vite/devsite/__fixtures__"]
}
