+void (*ass_trace_sink)(const char *line) = NULL;
+
+typedef struct {
+    char *s;
+    size_t len, cap;
+} TraceBuf;
+
+static void trace_put(TraceBuf *b, const char *fmt, ...)
+{
+    for (;;) {
+        va_list ap;
+        va_start(ap, fmt);
+        int n = vsnprintf(b->s ? b->s + b->len : NULL, b->s ? b->cap - b->len : 0, fmt, ap);
+        va_end(ap);
+        if (n < 0)
+            abort();
+        if (b->s && b->len + n < b->cap) {
+            b->len += n;
+            return;
+        }
+        b->cap = (b->cap + n + 1) * 2;
+        b->s = realloc(b->s, b->cap);
+        if (!b->s)
+            abort();
+    }
+}
+
+static void trace_num(TraceBuf *b, double v)
+{
+    trace_put(b, "%.6f", v == 0 ? 0.0 : v);
+}
+
+static void trace_json_char(TraceBuf *b, unsigned ch)
+{
+    if (ch == '"' || ch == '\\')
+        trace_put(b, "\\%c", (char) ch);
+    else if (ch < 0x20)
+        trace_put(b, "\\u%04x", ch);
+    else {
+        char utf8[5] = {0};
+        ass_utf8_put_char(utf8, ch);
+        trace_put(b, "%s", utf8);
+    }
+}
+
+static void trace_glyph_list(TraceBuf *b, GlyphInfo *start, GlyphInfo *end, bool text)
+{
+    bool first = true;
+    for (GlyphInfo *g = start; g < end; g++) {
+        if (g->skip)
+            continue;
+        for (GlyphInfo *info = g; info; info = info->next) {
+            if (info->symbol == '\n' || info->symbol == 0)
+                continue;
+            if (text) {
+                trace_json_char(b, info->symbol);
+                continue;
+            }
+            trace_put(b, first ? "{\"x\":" : ",{\"x\":");
+            trace_num(b, d6_to_double(info->pos.x));
+            trace_put(b, ",\"y\":");
+            trace_num(b, d6_to_double(info->pos.y));
+            trace_put(b, ",\"adv\":");
+            trace_num(b, d6_to_double(info->cluster_advance.x));
+            trace_put(b, ",\"ch\":%u}", info->symbol);
+            first = false;
+        }
+    }
+}
+
+// The event's fields of a trace line, from "lines" on; runs split as render_and_combine_glyphs splits them.
+static char *trace_event(RenderContext *state)
+{
+    TextInfo *text_info = &state->text_info;
+    TraceBuf b = {0};
+    trace_put(&b, "\"lines\":%d,\"clip\":", text_info->n_lines);
+    if (state->clip_drawing_text.str) {
+        trace_put(&b, "{\"vector\":\"");
+        for (size_t i = 0; i < state->clip_drawing_text.len; i++)
+            trace_json_char(&b, (unsigned char) state->clip_drawing_text.str[i]);
+        trace_put(&b, "\",\"scale\":%d,\"inverse\":%s}", state->clip_drawing_scale,
+                  state->clip_drawing_mode ? "true" : "false");
+    } else {
+        trace_put(&b, "{\"rect\":[%d,%d,%d,%d],\"inverse\":%s}", state->clip_x0, state->clip_y0,
+                  state->clip_x1, state->clip_y1, state->clip_mode ? "true" : "false");
+    }
+    trace_put(&b, ",\"runs\":[");
+    unsigned run = 0;
+    bool new_run = true;
+    GlyphInfo *run_start = NULL;
+    for (int i = 0; i <= text_info->length; i++) {
+        GlyphInfo *info = i < text_info->length ? text_info->glyphs + i : NULL;
+        if (info && info->starts_new_run)
+            new_run = true;
+        if (info && info->skip)
+            continue;
+        if (!info || new_run) {
+            if (run_start) {
+                GlyphInfo *g = run_start;
+                CombinedBitmapInfo *cb = run - 1 < text_info->n_bitmaps ? &text_info->combined_bitmaps[run - 1] : NULL;
+                uint32_t c[4];
+                for (int k = 0; k < 4; k++) {
+                    c[k] = g->c[k];
+                    ass_apply_fade(&c[k], g->fade);
+                }
+                trace_put(&b, "%s{\"text\":\"", run > 1 ? "," : "");
+                trace_glyph_list(&b, run_start, info ? info : text_info->glyphs + text_info->length, true);
+                trace_put(&b, "\",\"font\":\"");
+                const char *family = g->font ? g->font->desc.family.str : "";
+                size_t family_len = g->font ? g->font->desc.family.len : 0;
+                for (size_t k = 0; k < family_len; k++)
+                    trace_json_char(&b, (unsigned char) family[k]);
+                trace_put(&b, "|");
+                const char *ps = g->font && g->font->faces[g->face_index] ?
+                    FT_Get_Postscript_Name(g->font->faces[g->face_index]) : NULL;
+                for (const char *p = ps; p && *p; p++)
+                    trace_json_char(&b, (unsigned char) *p);
+                trace_put(&b, "\",\"size\":");
+                trace_num(&b, g->font_size);
+                trace_put(&b, ",\"scale\":[");
+                trace_num(&b, g->scale_x);
+                trace_put(&b, ",");
+                trace_num(&b, g->scale_y);
+                trace_put(&b, "],\"hspacing\":");
+                trace_num(&b, g->hspacing);
+                trace_put(&b, ",\"colors\":[\"%08X\",\"%08X\",\"%08X\",\"%08X\"],\"border\":[", c[0], c[1], c[2], c[3]);
+                trace_num(&b, g->border_x);
+                trace_put(&b, ",");
+                trace_num(&b, g->border_y);
+                trace_put(&b, "],\"shadow\":[");
+                trace_num(&b, g->shadow_x);
+                trace_put(&b, ",");
+                trace_num(&b, g->shadow_y);
+                trace_put(&b, "],\"blur\":");
+                trace_num(&b, g->blur);
+                trace_put(&b, ",\"be\":%d,\"rot\":[", g->be);
+                trace_num(&b, g->frx);
+                trace_put(&b, ",");
+                trace_num(&b, g->fry);
+                trace_put(&b, ",");
+                trace_num(&b, g->frz);
+                trace_put(&b, "],\"shear\":[");
+                trace_num(&b, g->fax);
+                trace_put(&b, ",");
+                trace_num(&b, g->fay);
+                trace_put(&b, "],\"borderStyle\":%d,\"flags\":%d,\"bold\":%u,\"italic\":%u,\"karaoke\":[%d,%d],\"drawing\":%s,\"matrix\":[",
+                          g->border_style, g->flags, g->bold, g->italic,
+                          cb ? (int) cb->effect_type : (int) g->effect_type,
+                          cb ? (int) cb->effect_timing : (int) g->effect_timing,
+                          g->drawing_text.str ? "true" : "false");
+                double norm = g->trace_m[2][2] ? g->trace_m[2][2] : 1;
+                for (int r = 0; r < 3; r++)
+                    for (int k = 0; k < 3; k++) {
+                        if (r || k)
+                            trace_put(&b, ",");
+                        trace_num(&b, g->trace_m[r][k] / norm);
+                    }
+                trace_put(&b, "],\"glyphs\":[");
+                trace_glyph_list(&b, run_start, info ? info : text_info->glyphs + text_info->length, false);
+                trace_put(&b, "]}");
+            }
+            if (!info)
+                break;
+            run_start = info;
+            run++;
+            new_run = false;
+        }
+    }
+    trace_put(&b, "]}");
+    return b.s;
+}
