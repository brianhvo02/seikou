    nav/stream-psrs.ts    from src/libbluray/bluray.c (_update_stream_psr_by_lang)
    nav/playback-psrs.ts  from src/libbluray/bluray.c (_update_playlist_psrs, _update_clip_psrs, _update_time_psr,
