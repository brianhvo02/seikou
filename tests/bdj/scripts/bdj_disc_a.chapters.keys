# BDJ_DISC_A (local disc): the main menu, then CHAPTERS, chapter 2. The chapter is a seek in the menu's playlist
# before BD-J title 1 starts the feature, playlist 00040.
wait playlist 149
wait still 1500   # the main menu has faded in, PLAY focused
key right         # CHAPTERS focused
wait still 1000
key ok            # the chapters panel opens, chapters 1-4
wait still 1500
key ok            # into the thumbnails: chapter 1 focused
wait still 1000
key down          # chapter 2
wait still 1000
key ok            # play chapter 2
wait playlist 40  # the feature
